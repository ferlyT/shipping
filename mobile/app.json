{
  "expo": {
    "name": "M-Shipping",
    "slug": "mshipping",
    "scheme": "mshipping",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi membutuhkan akses kamera untuk memindai barcode resi pengiriman.",
        "NSFaceIDUsageDescription": "Aplikasi membutuhkan FaceID untuk autentikasi biometrik."
      }
    },
    "android": {
      "package": "com.mshipping.mobile",
      "versionCode": 4,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 24,
      "buildToolsVersion": "34.0.0",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F17",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi membutuhkan akses kamera untuk memindai barcode resi."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Izinkan aplikasi menggunakan FaceID untuk login cepat."
        }
      ],
      "./plugins/withCleartextTraffic.js"
    ]
  }
}
